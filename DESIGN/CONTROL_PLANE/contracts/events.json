{
  "schemas": {
    "ExecutionStarted": {
      "type": "object",
      "properties": {
        "execution_id": { "type": "string" },
        "protocol_hash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["execution_id", "protocol_hash"]
    },
    "EffectTriggered": {
      "type": "object",
      "properties": {
        "effect_type": { "type": "string" },
        "target": { "type": "string" },
        "payload": { "type": "object" }
      },
      "required": ["effect_type", "target"]
    },
    "SolanaTransactionSigned": {
      "type": "object",
      "properties": {
        "signature": { "type": "string" },
        "program_id": { "type": "string" },
        "accounts": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["signature", "program_id"]
    }
  }
}
