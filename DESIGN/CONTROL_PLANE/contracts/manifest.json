{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "System Version Manifest",
  "type": "object",
  "properties": {
    "system_version": { "type": "string" },
    "release_date": { "type": "string", "format": "date-time" },
    "components": {
      "type": "object",
      "properties": {
        "control_plane": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "commit_hash": { "type": "string" },
            "spec_version": { "type": "string" }
          },
          "required": ["version", "spec_version"]
        },
        "runtime_plane": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "commit_hash": { "type": "string" },
            "solana_program_id": { "type": "string" }
          },
          "required": ["version"]
        }
      },
      "required": ["control_plane", "runtime_plane"]
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "min_runtime_version": { "type": "string" },
        "supported_specs": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["system_version", "components"]
}
